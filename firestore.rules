rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unspecified documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'elherreroanapse@gmail.com' ||
        request.auth.token.email == 'anapse_video@hotmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMINISTRADOR')
      );
    }

    function isModerator() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MODERADOR')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Platform analytics: anonymous traffic counters. These counters never store IP addresses or personal data.
    match /analytics/{docId} {
      allow read: if true;
      allow create: if docId == 'platform' &&
        request.resource.data.totalVisits == 1 &&
        (request.resource.data.totalUniqueVisitors == 0 || request.resource.data.totalUniqueVisitors == 1);
      allow update: if docId == 'platform' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits', 'totalUniqueVisitors', 'updatedAt']) &&
        request.resource.data.totalVisits == resource.data.totalVisits + 1 &&
        (request.resource.data.totalUniqueVisitors == resource.data.totalUniqueVisitors ||
         request.resource.data.totalUniqueVisitors == resource.data.totalUniqueVisitors + 1);
    }

    match /analytics/daily/{dateId} {
      allow read: if true;
      allow create: if request.resource.data.visits == 1 &&
        (request.resource.data.uniqueVisitors == 0 || request.resource.data.uniqueVisitors == 1);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'visits', 'uniqueVisitors', 'updatedAt']) &&
        request.resource.data.visits == resource.data.visits + 1 &&
        (request.resource.data.uniqueVisitors == resource.data.uniqueVisitors ||
         request.resource.data.uniqueVisitors == resource.data.uniqueVisitors + 1);
    }

    match /analytics/visitors/{visitorId} {
      allow read: if true;
      allow create: if request.resource.data.firstSeenAt is string &&
        request.resource.data.lastSeenAt is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstSeenAt', 'lastSeenAt']) &&
        request.resource.data.firstSeenAt == resource.data.firstSeenAt &&
        request.resource.data.lastSeenAt is string;
    }

    match /analytics/sources/{sourceId} {
      allow read: if true;
      allow create: if request.resource.data.visits == 1 &&
        (request.resource.data.uniqueVisitors == 0 || request.resource.data.uniqueVisitors == 1);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['source', 'medium', 'campaign', 'visits', 'uniqueVisitors', 'updatedAt']) &&
        request.resource.data.visits == resource.data.visits + 1 &&
        (request.resource.data.uniqueVisitors == resource.data.uniqueVisitors ||
         request.resource.data.uniqueVisitors == resource.data.uniqueVisitors + 1);
    }

    // Games collection
    match /games/{gameId} {
      allow read: if true; // Public catalog
      allow create, delete: if isAdmin();
      // Game view/play counters must work for anonymous visitors too.
      // Keep all other game edits restricted to admins/authenticated users.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) &&
        request.resource.data.viewsCount == resource.data.viewsCount + 1
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playsCount']) &&
        request.resource.data.playsCount == resource.data.playsCount + 1
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'playsCount', 'likesCount', 'ratingAvg', 'ratingsCount', 'updatedAt'])
      );
    }

    // Users profile collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'USUARIO' ||
        (request.resource.data.role == 'ADMINISTRADOR' && (request.auth.token.email == 'elherreroanapse@gmail.com' || request.auth.token.email == 'anapse_video@hotmail.com'))
      );
      allow update: if isAdmin() || (
        isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Proposals collection
    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || isModerator() || (
        isSignedIn() &&
        (request.resource.data.authorId == request.auth.uid ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesCount', 'commentsCount']))
      );
      allow delete: if isAdmin() || isModerator() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // Proposal Votes
    match /proposalVotes/{voteId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Polls
    match /polls/{pollId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes', 'options'])
      );
    }

    // Poll Votes
    match /pollVotes/{voteId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Comments & Replies
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isModerator() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'hidden', 'hiddenBy', 'hiddenAt', 'moderatedBy', 'moderatedAt', 'moderationAction'])
        )
      );
      allow delete: if isAdmin() || isModerator() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Reports / Denuncias
    match /reports/{reportId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isModerator();
    }

    // Moderation Audit Logs
    match /moderationLogs/{logId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isAdmin() || isModerator();
      allow update, delete: if isAdmin();
    }

    // Donations & Support
    match /donations/{donationId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }

    // Game Likes registry
    match /gameLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Comment Likes registry
    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Scores (Rankings)
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if true; // Allow guests and logged-in users to submit scores
      allow update, delete: if isAdmin();
    }

    // Fox Thief Ranking collection
    match /fox_thief_ranking/{scoreId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Platform Tools
    match /tools/{toolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Config
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
